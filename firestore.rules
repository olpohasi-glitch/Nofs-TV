rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Official NOFS TV Administrator authorization:
    // Strictly verifies email against the official authorized administrator account
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'nofstv.bd@gmail.com' ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 100;
    }

    // NEWS ARTICLES:
    // - Public visitors have READ-ONLY access to published news.
    // - Draft news is NEVER publicly readable.
    // - Only authenticated and authorized administrator can create, edit, delete, or change status/flags.
    match /news/{newsId} {
      allow get: if isValidId(newsId) && (
        isAdmin() || resource.data.status == 'published'
      );
      allow list: if isAdmin() || resource.data.status == 'published';
      
      allow create: if isAdmin() && isValidId(newsId) &&
        request.resource.data.keys().hasAll(['title', 'content', 'category', 'status']) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.content is string &&
        request.resource.data.status in ['published', 'draft', 'archived'];
        
      allow update: if isAdmin() && isValidId(newsId) &&
        request.resource.data.status in ['published', 'draft', 'archived'];
        
      allow delete: if isAdmin() && isValidId(newsId);
    }

    // CATEGORIES:
    // - Public visitors have READ-ONLY access.
    // - Only authorized administrator can create, edit, or delete categories.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(categoryId);
    }

    // REPORTERS:
    // - Public visitors have READ-ONLY access.
    // - Only authorized administrator can add, edit, or delete reporters.
    match /reporters/{reporterId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(reporterId);
    }

    // MEDIA LIBRARY:
    // - Public visitors have READ-ONLY access to media metadata.
    // - Only authorized administrator can save, modify, or delete media items.
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(mediaId);
    }

    // COMMENTS:
    // - Public visitors can submit comments with pending status.
    // - Public visitors can only read approved comments.
    // - Only authorized administrator can approve, hide, edit, or delete comments.
    match /comments/{commentId} {
      allow get: if isValidId(commentId) && (isAdmin() || resource.data.status == 'approved');
      allow list: if isAdmin() || resource.data.status == 'approved';
      allow create: if isValidId(commentId) && 
        request.resource.data.authorName is string &&
        request.resource.data.authorName.size() > 0 &&
        request.resource.data.authorName.size() <= 100 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 1000 &&
        request.resource.data.status == 'pending';
      allow update, delete: if isAdmin() && isValidId(commentId);
    }

    // WEBSITE SETTINGS:
    // - Public visitors have READ-ONLY access.
    // - Only authorized administrator can modify site settings.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(settingId);
    }

    // ADMINS & USERS COLLECTION:
    // - Only authorized administrator can manage admin accounts
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // USERS COLLECTION:
    // - Only authorized administrator can manage users. No public user self-registration into roles.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // CONNECTION TEST DOCUMENT:
    match /test/{testId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
